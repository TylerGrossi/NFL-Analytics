{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "gridiron-analytics",
  // Deliberately outside src/ — Next's tsconfig globs `**/*.ts` under the app,
  // and the Worker's Cloudflare globals are not in scope there.
  "main": "worker/index.ts",
  "compatibility_date": "2025-11-01",

  // The site is prerendered at build time (DuckDB runs in the GitHub Action,
  // where the native binding works). Everything under `out/` is served straight
  // from Cloudflare's edge with no Worker invocation.
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "not_found_handling": "404-page",

    // Only these paths wake the Worker. Everything else — every prerendered
    // page, every chunk — is served directly, which keeps us inside the free
    // tier's 100k daily Worker invocations.
    "run_worker_first": ["/api/*", "/data/*"]
  },

  "observability": { "enabled": true },

  "vars": {
    // Where the browser fetches parquet from.
    //
    // The default is a same-origin path served by the Worker out of the R2
    // binding, which means the site needs no custom domain and no CORS config.
    // Once a domain exists, point this at an R2 custom domain instead — the
    // browser then reads from R2's CDN directly, the /data/* route stops being
    // hit, and Worker invocations drop to just the live ESPN calls.
    "PARQUET_BASE": "/data"
  },

  "r2_buckets": [
    {
      "binding": "PARQUET",
      "bucket_name": "gridiron-parquet"
    }
  ],

  "env": {
    "preview": {
      "vars": {
        "PARQUET_BASE": "/data"
      },
      "r2_buckets": [
        {
          "binding": "PARQUET",
          "bucket_name": "gridiron-parquet-preview"
        }
      ]
    }
  }
}
