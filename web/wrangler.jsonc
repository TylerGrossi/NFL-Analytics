{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "hashmark",
  // Deliberately outside src/ — Next's tsconfig globs `**/*.ts` under the app,
  // and the Worker's Cloudflare globals are not in scope there.
  "main": "worker/index.ts",
  "compatibility_date": "2025-11-01",

  // The site is prerendered at build time (DuckDB runs in the GitHub Action,
  // where the native binding works). Everything under `out/` is served straight
  // from Cloudflare's edge with no Worker invocation.
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "not_found_handling": "404-page",

    // Only these paths wake the Worker. Everything else — every prerendered
    // page, every chunk — is served directly, which keeps us inside the free
    // tier's 100k daily Worker invocations.
    "run_worker_first": ["/api/*"]
  },

  "observability": { "enabled": true },

  "vars": {
    // Public base for the parquet store. Overridden per environment below.
    // DuckDB-WASM range-reads these directly from R2's CDN, so the Worker is
    // not in the path for data.
    "PARQUET_BASE": "https://data.hashmark.dev"
  },

  // The bucket is bound for the sync/verify script and for any future
  // server-side read. Browser reads go over the public custom domain instead,
  // so they cost no Worker invocations.
  "r2_buckets": [
    {
      "binding": "PARQUET",
      "bucket_name": "hashmark-parquet"
    }
  ],

  "env": {
    "preview": {
      "vars": {
        "PARQUET_BASE": "https://data-preview.hashmark.dev"
      },
      "r2_buckets": [
        {
          "binding": "PARQUET",
          "bucket_name": "hashmark-parquet-preview"
        }
      ]
    }
  }
}
