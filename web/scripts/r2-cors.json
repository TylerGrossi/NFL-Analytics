[
  {
    "AllowedOrigins": [
      "https://hashmark.dev",
      "https://www.hashmark.dev",
      "http://localhost:3000",
      "http://localhost:8788"
    ],
    "AllowedMethods": ["GET", "HEAD"],
    "AllowedHeaders": ["range", "if-match", "if-none-match"],
    "ExposeHeaders": [
      "content-length",
      "content-range",
      "content-type",
      "accept-ranges",
      "etag"
    ],
    "MaxAgeSeconds": 86400
  }
]
